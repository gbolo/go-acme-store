# ACME Store Docker Environment Configuration
# Copy this file to .env and fill in your values

# Application Version (for Docker build)
VERSION=devel
COMMIT_REF=unknown

# Logging
LOG_LEVEL=INFO

# ACME Configuration
# Use staging for testing: https://acme-staging-v02.api.letsencrypt.org/directory
# Use production: https://acme-v02.api.letsencrypt.org/directory
ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_ACCOUNT_EMAIL=your-email@example.com
ACME_DNS_SERVER=8.8.8.8:53
ACME_DNS_PROVIDER=digitalocean
ACME_TLS_INSECURE_SKIP_VERIFY=false

# DNS Provider Tokens (use appropriate one based on ACME_DNS_PROVIDER)
# For DigitalOcean
DIGITALOCEAN_TOKEN=your-digitalocean-token-here

# For PowerDNS
POWERDNS_SERVER_URL=https://pdns.example.com
POWERDNS_API_TOKEN=your-powerdns-api-token
POWERDNS_SERVER_ID=localhost

# For ACME-DNS
ACMEDNS_SERVER_URL=http://localhost:8053

# Vault Configuration
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root
VAULT_KV2_MOUNT=kv
VAULT_KV2_SECRET_PATH=acme
VAULT_TLS_SKIP_VERIFY=false

